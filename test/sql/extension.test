# name: test/sql/extension.test
# description: test observefs extension loading
# group: [sql]

require observefs

query I
SELECT COUNT(*) FROM duckdb_extensions() WHERE extension_name = 'observefs';
----
1

query T
SELECT extension_version FROM duckdb_extensions() WHERE extension_name = 'observefs';
----
0.5.4

query I
SELECT * FROM observefs_list_registered_filesystems();
----
observability-HTTPFileSystem
observability-HuggingFaceFileSystem
observability-S3FileSystem
observefs_fake_filesystem
